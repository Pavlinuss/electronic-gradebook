{
  "name": "electronic-gradebook-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for an electronic student gradebook",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:test": "sequelize-cli db:migrate --env test",
    "db:seed": "sequelize-cli db:seed:all",
    "db:undo": "sequelize-cli db:migrate:undo:all",
    "user:admin": "node scripts/make-admin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.2"
  }
}
