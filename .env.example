PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/electronic_gradebook
# Set DB_SSL=true for Neon/Supabase when required by the provider.
DB_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the generated value in .env, never commit that file.
JWT_SECRET=
# Optional: a SEPARATE migrated PostgreSQL database for integration tests.
TEST_DATABASE_URL=
